 &control
    calculation = 'bands'
    restart_mode='from_scratch',
    prefix='MoS2',
    pseudo_dir = '../pseudo/',
    outdir='./tmp/',
    verbosity='high'
 /
 &system
    ibrav=  4,
    celldm(1)=5.94175933,
    celldm(3)=6.73201282,
    nat=  3,
    ntyp= 2,
    ecutwfc = 80.0,
    assume_isolated='2D'
    force_symmorphic=.true.
    nbnd=200
 /
 &electrons
    diagonalization='david'
 /
ATOMIC_SPECIES
Mo 95.95 Mo.pbesol.dojo.upf
S 32.065 S.pbesol.dojo.upf
ATOMIC_POSITIONS crystal
Mo               0.3333333000        0.6666666000        0.5000000000    0   0   0
S                0.6666666670        0.3333333330        0.5735812426    0   0   1
S                0.6666666670        0.3333333330        0.4264187574    0   0   1
K_POINTS crystal_b
4
 0.0000  0.0000  0.0000  40  ! Gamma (Center)
 0.3333  0.3333  0.0000  40  ! K (Corner)
 0.5000  0.0000  0.0000  40  ! M (Edge center)
 0.0000  0.0000  0.0000  1   ! Back to Gamma
