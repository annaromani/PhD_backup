 &control
    calculation = 'nscf'
    restart_mode='from_scratch',
    prefix='MoS2',
    pseudo_dir = '../pseudo/',
    outdir='./tmp/',
    verbosity='high',
    wf_collect=.true.
 /
 &system
    ibrav=  4,
    celldm(1)=5.94774857
    celldm(3)=6.72523384
    nat=  3,
    ntyp= 2,
    ecutwfc = 80.0,
    assume_isolated='2D'
    force_symmorphic=.true. 
    nbnd=200
/
 &electrons
    diagonalization='david'
 /
ATOMIC_SPECIES
Mo 95.95 Mo.pbesol.dojo.upf
S 32.065 S.pbesol.dojo.upf
ATOMIC_POSITIONS (crystal)
Mo               0.3333333000        0.6666666000        0.0000000000
S                0.6666666666        0.3333333333        0.0735295046    0   0   1
S                0.6666666666        0.3333333333       -0.0735295046    0   0   1
K_POINTS crystal_b
4
 0.0000  0.0000  0.0000  40  ! Gamma (Center)
 0.3333  0.3333  0.0000  40  ! K (Corner)
 0.5000  0.0000  0.0000  40  ! M (Edge center)
 0.0000  0.0000  0.0000  1   ! Back to Gamma
